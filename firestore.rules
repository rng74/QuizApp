rules_version = '2';

// Anime Quiz — global leaderboard. No Cloud Functions: the client writes its own
// `leaderboard/{uid}` doc; these rules are the only server-side guard.
// Deploy: firebase deploy --only firestore:rules  (or paste in console → Firestore → Rules)
service cloud.firestore {
  match /databases/{database}/documents {

    match /leaderboard/{uid} {
      // Any signed-in (anonymous) player can read the board.
      allow read: if request.auth != null;

      // A player may only write their own doc, with a bounded, monotonic best score.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'mode', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.mode is string
        && request.resource.data.mode.size() <= 16
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && (
             !exists(/databases/$(database)/documents/leaderboard/$(uid))
             || request.resource.data.score >= resource.data.score
           );

      allow delete: if false;
    }

    // Anime Quiz — Daily Challenge shared stats. One attempt doc per player per UTC day.
    // The track is deterministic client-side; these docs only aggregate how players did.
    match /daily/{day}/attempts/{uid} {
      // Any signed-in (anonymous) player can read aggregate stats for a day.
      allow read: if request.auth != null;

      // A player may only write their own attempt, bounded and monotonic on score.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['score', 'correct', 'updatedAt'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.correct is bool
        && (
             !exists(/databases/$(database)/documents/daily/$(day)/attempts/$(uid))
             || request.resource.data.score >= resource.data.score
           );

      allow delete: if false;
    }

    // Anime Quiz — async Duel. One doc per 6-char room code. No Cloud Functions: the host
    // creates the room, the guest claims the empty slot, and each side writes only its own
    // score exactly once. Track is seed-deterministic client-side (nothing sensitive stored).
    match /duels/{code} {
      allow read: if request.auth != null;

      // Host creates the room owning the doc; both score slots start empty.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['hostUid', 'hostName', 'seed', 'guestUid', 'guestName', 'createdAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() <= 24
        && request.resource.data.seed is int
        && request.resource.data.guestUid == ''
        && request.resource.data.guestName == '';

      allow update: if request.auth != null && (
          // (a) Guest claims the still-empty slot.
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['guestUid', 'guestName'])
            && resource.data.guestUid == ''
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.guestName is string
            && request.resource.data.guestName.size() <= 24
          )
          // (b) Host writes its own score, once.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostScore'])
            && request.auth.uid == resource.data.hostUid
            && !('hostScore' in resource.data)
            && request.resource.data.hostScore is int
            && request.resource.data.hostScore >= 0
            && request.resource.data.hostScore <= 100000
          )
          // (c) Guest writes its own score, once.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestScore'])
            && request.auth.uid == resource.data.guestUid
            && !('guestScore' in resource.data)
            && request.resource.data.guestScore is int
            && request.resource.data.guestScore >= 0
            && request.resource.data.guestScore <= 100000
          )
        );

      allow delete: if false;
    }

    // Everything else is closed until its own rules are written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
